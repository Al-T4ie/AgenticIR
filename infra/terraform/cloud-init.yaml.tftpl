#cloud-config
# Hardened Docker host for AgenticIR. The heavy lifting lives in
# bootstrap.sh.tftpl, embedded below, so this file stays plain YAML.

hostname: ${hostname}
fqdn: ${hostname}
preserve_hostname: false
timezone: ${timezone}

package_update: true
package_upgrade: true

packages:
  - curl
  - wget
  - git
  - jq
  - ufw
  - fail2ban
  - unattended-upgrades
  - apt-listchanges
  - ca-certificates
  - gnupg
  - htop
  - ncdu
  - rsync
  - unzip

write_files:
  # ── Unattended security updates ──
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /etc/apt/apt.conf.d/50unattended-upgrades
    content: |
      Unattended-Upgrade::Allowed-Origins {
        "$${distro_id}:$${distro_codename}-security";
        "$${distro_id}ESMApps:$${distro_codename}-apps-security";
        "$${distro_id}ESM:$${distro_codename}-infra-security";
      };
      Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      // Kernel updates need a reboot; take it in a quiet window rather than never.
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:30";

  # ── SSH hardening ──
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    content: |
      PermitRootLogin prohibit-password
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      PermitEmptyPasswords no
      X11Forwarding no
      MaxAuthTries 3
      LoginGraceTime 30
      ClientAliveInterval 300
      ClientAliveCountMax 2
      AllowAgentForwarding no

  # ── fail2ban ──
  - path: /etc/fail2ban/jail.d/sshd.local
    content: |
      [sshd]
      enabled = true
      port = ssh
      filter = sshd
      backend = systemd
      maxretry = 4
      findtime = 600
      bantime = 3600
      bantime.increment = true
      bantime.maxtime = 86400

  # ── Docker daemon: bounded logs, predictable subnets ──
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" },
        "live-restore": true,
        "default-address-pools": [
          { "base": "172.20.0.0/16", "size": 24 }
        ]
      }

  # ── Kernel tuning for a container host running Postgres and many sockets ──
  - path: /etc/sysctl.d/99-agenticir.conf
    content: |
      vm.swappiness = 10
      vm.overcommit_memory = 1
      vm.max_map_count = 262144
      net.core.somaxconn = 4096
      net.ipv4.tcp_max_syn_backlog = 4096
      net.ipv4.ip_local_port_range = 10240 65535
      fs.inotify.max_user_watches = 524288
      fs.inotify.max_user_instances = 1024
      fs.file-max = 2097152

  # ── The bootstrap script itself ──
  - path: /usr/local/sbin/agenticir-bootstrap.sh
    permissions: "0750"
    owner: root:root
    content: |
      ${indent(6, bootstrap_script)}

runcmd:
  - [systemctl, restart, ssh]
  - [/usr/local/sbin/agenticir-bootstrap.sh]

final_message: "AgenticIR host ready after $UPTIME seconds. Coolify: http://$IPV4:8000"
