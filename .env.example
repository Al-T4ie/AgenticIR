# ─────────────────────────────────────────────────────────────────────────────
#  AgenticIR — environment contract
#
#  Local dev:  cp .env.example .env  &&  edit  &&  make up
#  Coolify:    paste the same keys into the resource's Environment Variables tab.
#              Values wrapped in $SERVICE_* are generated by Coolify itself —
#              see infra/coolify/docker-compose.coolify.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # console | json   (use json in production)
PUBLIC_BASE_URL=http://localhost:8000

# Shared secret for the /v1 REST API. Send as `X-API-Key: ...`.
# Generate with: openssl rand -hex 32
API_KEY=dev-local-key-change-me

# Comma-separated origins allowed to call the API from a browser. * in dev only.
CORS_ORIGINS=*

# ── LLM routing ──────────────────────────────────────────────────────────────
# provider: anthropic | openrouter | openai | ollama
LLM_PROVIDER=anthropic

# anthropic
ANTHROPIC_API_KEY=

# openrouter (OpenAI-compatible gateway). OPENROUTER_API_TOKEN also works.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# openai, or any OpenAI-compatible gateway (LiteLLM, vLLM, corporate proxy).
# Leave OPENAI_BASE_URL empty for api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ollama
OLLAMA_BASE_URL=http://ollama:11434

# Per-role models. Cheap models for high-volume specialists, strong for planning.
# These defaults are the direct-Anthropic IDs. With LLM_PROVIDER=openrouter the
# IDs are namespaced and MUST be set explicitly — see below.
LLM_MODEL_SUPERVISOR=claude-sonnet-5
LLM_MODEL_SPECIALIST=claude-haiku-4-5-20251001
LLM_MODEL_CRITIC=claude-opus-5

# ── OpenRouter model set ─────────────────────────────────────────────────────
# Verified present on OpenRouter, all three advertising tools + structured
# output, which every role here depends on.
#
#   LLM_MODEL_SUPERVISOR=minimax/minimax-m3          # $0.30/$1.20 per M, 1M ctx
#   LLM_MODEL_SPECIALIST=anthropic/claude-haiku-4.5  # $1.00/$5.00 per M
#   LLM_MODEL_CRITIC=openai/gpt-5.6-terra            # $1.00/$6.00 per M, 1M ctx
#
# Deliberately cross-vendor: the critic reviewing the specialists' work comes
# from a different lab than the specialists, so the review is independent
# rather than a model grading its own family's output.
#
# All-Anthropic alternative:
#   LLM_MODEL_SUPERVISOR=anthropic/claude-sonnet-5
#   LLM_MODEL_SPECIALIST=anthropic/claude-haiku-4.5
#   LLM_MODEL_CRITIC=anthropic/claude-opus-5
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ── Agent behaviour ──────────────────────────────────────────────────────────
MAX_INVESTIGATION_ROUNDS=3           # supervisor <-> specialist loops per incident
MAX_PARALLEL_SPECIALISTS=5           # fan-out width for the swarm
REQUIRE_APPROVAL_FOR_CONTAINMENT=true
AUTO_APPROVE_SEVERITY_BELOW=low      # low|medium|high|critical|never

# ── Persistence ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agenticir
POSTGRES_USER=agenticir
POSTGRES_PASSWORD=agenticir-local-dev
REDIS_URL=redis://redis:6379/0

# ── Slack ────────────────────────────────────────────────────────────────────
# https://api.slack.com/apps -> create app from infra/slack/manifest.yaml
SLACK_ENABLED=false
SLACK_BOT_TOKEN=                     # xoxb-...
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#incident-response

# Narrate each phase of an investigation into the incident thread.
SLACK_PROGRESS_UPDATES=true

# Sweep the channel periodically so the bot notices information it was not
# mentioned in. Needs channels:history + channels:read (groups:* if private).
SLACK_POLL_ENABLED=false
SLACK_POLL_INTERVAL_SECONDS=300
SLACK_POLL_CHANNELS=                 # C0123ABCD,#other-channel — blank uses SLACK_DEFAULT_CHANNEL
SLACK_POLL_MAX_ACTIONS=3             # investigations/revisions a single sweep may trigger
SLACK_POLL_LOOKBACK_MINUTES=60       # how far back the very first sweep reads
SLACK_POLL_THREAD_WINDOW_HOURS=24    # keep re-reading threads of incidents this recent
SLACK_POLL_REPORT_DECISIONS=true     # post what each sweep read and why it chose what it chose

# ── Incident war rooms ───────────────────────────────────────────────────────
# A channel per incident instead of a thread in the shared one. Needs a scope
# the bot does not have by default: groups:write (private) or channels:manage
# (public), then reinstall. Creation fails closed — the incident falls back to
# a thread rather than going unannounced.
SLACK_WARROOM_ENABLED=false
SLACK_WARROOM_PRIVATE=true           # incident channels name individual staff
SLACK_WARROOM_PREFIX=inc
SLACK_WARROOM_INVITE=                # comma-separated user ids always pulled in
SLACK_WARROOM_ANNOUNCE=true          # point the origin channel at the new room

# ── Agent autonomy ───────────────────────────────────────────────────────────
# spectator: answers when asked, touches nothing (where every incident starts)
# winger:    investigates on its own, checks in, asks before acting
# responder: investigates and acts, up to the risk ceiling
IR_MODE_DEFAULT=spectator
IR_MODE_UNLOCK_SECONDS=300           # how long the room must be open before the ladder unlocks
IR_AUTONOMOUS_MAX_RISK=medium        # low|medium|high|all|none — irreversible is gated unless `all`
IR_DIGEST_SECONDS=600                # catch-up cadence in winger and responder modes

# ── Long-running incidents ───────────────────────────────────────────────────
# The caretaker that runs between graph executions: publishes catch-ups and
# stops a stale approval freezing the investigation. A five-hour incident spends
# most of its life here; a fifteen-minute one never touches it.
UPKEEP_ENABLED=true
UPKEEP_INTERVAL_SECONDS=60
# How long a plan may sit unapproved with new information queued behind it
# before it is withdrawn and rebuilt on the current picture. Nothing is ever
# executed by a withdrawal. 0 lets plans wait indefinitely.
STALE_GATE_SECONDS=1800

# ── n8n bridge ───────────────────────────────────────────────────────────────
N8N_ENABLED=false
N8N_BASE_URL=http://n8n:5678
# Shared bearer token: agents send it to n8n, n8n sends it back to us.
N8N_WEBHOOK_TOKEN=
# Comma-separated n8n webhook paths exposed to agents as tools.
# Format: toolname:webhook/path:description
N8N_TOOLS=enrich_ioc:agentic-ir/enrich-ioc:Look up an IP/domain/hash in threat intel,create_ticket:agentic-ir/create-ticket:Open an incident ticket

# ── Observability ────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ir

# ── n8n container settings (compose only, not read by the app) ───────────────
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum-secret
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
